# No need to edit this by hand: run the setup wizard
#   python playlist_sync.py setup     (git clone)
#   ytmusic-sync setup                (pip install)
# It asks for every value below and saves it to .env for you.
# Values still reading your_..._here count as not set.

# ── Spotify API ──────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Target Spotify playlist ID or full link (https://open.spotify.com/playlist/...)
SPOTIFY_PLAYLIST_ID=your_playlist_id_here

# ── YT Music ─────────────────────────────────────────────────────
# Source playlist ID or full link (https://music.youtube.com/playlist?list=PLAYLIST_ID)
YTMUSIC_PLAYLIST_ID=your_playlist_id_here

# Auth file written by the wizard's YT Music login step (relative to the settings folder)
YTMUSIC_AUTH_FILE=browser.json

# ── Last.fm API (optional, for enrichment) ──────────────────────
# Free API key from https://www.last.fm/api/account/create
# Adds play counts, listener counts, and genre tags to enriched CSV
# LASTFM_API_KEY=your_api_key_here

# ── Optional ─────────────────────────────────────────────────────
# Path to a CSV export of your playlist (for --from-csv mode)
# SOURCE_CSV=playlist_export.csv
